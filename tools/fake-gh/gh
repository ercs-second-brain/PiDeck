#!/usr/bin/env node
// A scripted stand-in for the gh CLI. Serves a mutable JSON repo state —
// pointed at by FAKE_GH_STATE — with exactly the surface the daemon's GitHub
// client uses, and applies writes back to that state file. No network.
// The state is multi-repo: every gh invocation carries its repo (the --repo
// flag, a repos/<owner>/<name>/... api path, or the --repo of repo view), and
// reads and writes the matching entry of state.repos.
import { readFileSync, renameSync, writeFileSync } from "node:fs";

const statePath = process.env.FAKE_GH_STATE;
if (!statePath) {
  fail("FAKE_GH_STATE is not set");
}

const args = process.argv.slice(2);
/** Raw body supplied with `gh api … --input -`. */
let stdinData = "";

function fail(message) {
  process.stderr.write(`fake-gh: ${message}\n`);
  process.exit(2);
}

function load() {
  return JSON.parse(readFileSync(statePath, "utf8"));
}

function save(state) {
  const tmp = `${statePath}.tmp`;
  writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`, "utf8");
  renameSync(tmp, statePath);
}

function loginFor(state) {
  const token = process.env.GH_TOKEN;
  return (token !== undefined && state.tokens[token]) || state.primaryLogin;
}

function repoNames(state) {
  return Object.keys(state.repos);
}

function repoEntry(state, repo) {
  const entry = state.repos[repo];
  if (entry === undefined) fail(`no repo ${repo} in fake state`);
  return entry;
}

function prUrl(repoName, number) {
  return `https://github.com/${repoName}/pull/${number}`;
}

/** The repo an argv carries: the --repo flag value, if present. */
function repoFlag(rest) {
  const values = flagValues(rest, "--repo");
  return values.length === 0 ? null : values[0];
}

function canRead(state, login, repo) {
  if (login === state.primaryLogin) return true;
  return (state.readAccess[repo] ?? []).includes(login);
}

function findIssue(repo, number) {
  return repo.issues.find((issue) => issue.number === number) ?? null;
}

function findPrOrDie(repo, number) {
  const pr = repo.prs.find((pr) => pr.number === number);
  if (pr === undefined) fail(`no pull request #${number}`);
  return pr;
}

function closeReferencedIssues(repo, pr) {
  for (const match of pr.body.matchAll(/(?:[Cc]loses|[Ff]ixes|[Rr]esolves) #(\d+)/g)) {
    const issue = findIssue(repo, Number(match[1]));
    if (issue !== null) issue.state = "closed";
  }
}

function nowIso() {
  return new Date().toISOString();
}

function nextId(state) {
  state.seq += 1;
  return state.seq;
}

function gh(state) {
  const login = loginFor(state);
  let method = "GET";
  let path = null;
  const fields = {};
  for (let i = 1; i < args.length; i++) {
    if (args[i] === "--method") {
      method = args[i + 1];
      i++;
    } else if (args[i] === "-f" || args[i] === "-F") {
      const [key, value = ""] = (args[i + 1] ?? "").split("=");
      fields[key] = value;
      i++;
    } else if (path === null) {
      path = args[i];
    }
  }
  if (path === null) fail("api: missing path");

  const [rawPath] = path.split("?");
  const segments = rawPath.replace(/^\//, "").split("/");
  const write = () => save(state);
  // The repo a repos/<owner>/<name>/... path addresses; null for user paths.
  const repo =
    segments[0] === "repos" && segments.length >= 3 ? `${segments[1]}/${segments[2]}` : null;

  if (method === "GET" && segmentsEqual(segments, ["user"])) {
    if (args.includes("--jq") && args[args.indexOf("--jq") + 1] === ".login") return emit(loginFor(state));
    return emit(JSON.stringify({ login: loginFor(state) }));
  }
  if (method === "GET" && segmentsEqual(segments, ["repos", "*", "*"])) {
    if (canRead(state, login, `${segments[1]}/${segments[2]}`)) return emit("{}");
    fail(`Must have read access to ${segments[1]}/${segments[2]} (as ${login})`);
  }
  if (method === "GET" && segmentsEqual(segments, ["repos", "*", "*", "issues", "*"])) {
    const issue = findIssue(repoEntry(state, repo), Number(segments[4]));
    if (issue === null) fail(`no issue #${segments[4]}`);
    return emit(JSON.stringify({ title: issue.title, body: issue.body ?? "" }));
  }
  if (method === "GET" && segmentsEqual(segments, ["repos", "*", "*", "commits", "*"])) {
    if (!canRead(state, login, repo)) fail(`Must have read access to ${repo} (as ${login})`);
    const sha = repoEntry(state, repo).upstreamSha ?? "0".repeat(40);
    if (args.includes("--jq") && args[args.indexOf("--jq") + 1] === ".sha") return emit(sha);
    return emit(JSON.stringify({ sha }));
  }
  if (method === "PUT" && segmentsEqual(segments, ["repos", "*", "*", "collaborators", "*"])) {
    const repo = `${segments[1]}/${segments[2]}`;
    const invitee = segments[4];
    const invited = state.invitations.some(
      (invitation) => invitation.repo === repo && invitation.invitee === invitee,
    );
    if (!invited && !(state.readAccess[repo] ?? []).includes(invitee)) {
      state.invitations.push({ id: nextId(state), repo, invitee });
      save(state);
    }
    return emit("");
  }
  if (segmentsEqual(segments, ["user", "repository_invitations"])) {
    if (method === "GET") {
      const invitations = state.invitations
        .filter((invitation) => invitation.invitee === login)
        .map((invitation) => ({ id: invitation.id, repo: invitation.repo }));
      return emit(JSON.stringify(invitations));
    }
    fail("api: unsupported method on /user/repository_invitations");
  }
  if (method === "PATCH" && segmentsEqual(segments, ["user", "repository_invitations", "*"])) {
    const id = Number(segments[2]);
    const invitation = state.invitations.find((entry) => entry.id === id);
    if (invitation === undefined) fail(`no invitation ${id}`);
    state.invitations = state.invitations.filter((invitation) => invitation.id !== id);
    const readers = state.readAccess[invitation.repo] ?? [];
    if (!readers.includes(invitation.invitee)) readers.push(invitation.invitee);
    state.readAccess[invitation.repo] = readers;
    write();
    return emit("");
  }
  if (segmentsEqual(segments, ["repos", "*", "*", "issues", "*", "dependencies", "blocked_by"])) {
    const r = repoEntry(state, repo);
    const issue = findIssue(r, Number(segments[4]));
    if (issue === null) fail(`no issue #${segments[4]}`);
    const blockers = issue.blockedBy.map((number) => ({
      number,
      state: findIssue(r, number)?.state ?? "open",
    }));
    return emit(JSON.stringify(blockers));
  }
  if (segmentsEqual(segments, ["repos", "*", "*", "issues", "*", "comments"])) {
    const r = repoEntry(state, repo);
    const number = Number(segments[4]);
    if (method === "GET") {
      return emit(JSON.stringify((r.comments[String(number)] ?? []).map(asGhComment)));
    }
    if (method === "POST") {
      const comment = { id: nextId(state), user: login, body: fields.body ?? "", created_at: nowIso() };
      const list = r.comments[String(number)] ?? [];
      list.push(comment);
      r.comments[String(number)] = list;
      write();
      return emit(JSON.stringify({ id: comment.id }));
    }
    fail("api: unsupported method on issue comments");
  }
  if (method === "POST" && segmentsEqual(segments, ["repos", "*", "*", "pulls", "*", "reviews"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    const payload = stdinData ? JSON.parse(stdinData) : {};
    const states = { APPROVE: "APPROVED", REQUEST_CHANGES: "CHANGES_REQUESTED", COMMENT: "COMMENTED" };
    const reviewState = states[payload.event];
    if (reviewState === undefined) fail(`reviews: unknown event ${payload.event}`);
    const review = {
      id: nextId(state),
      user: login,
      state: reviewState,
      submitted_at: nowIso(),
      body: payload.body ?? null,
      commit_id: pr.headRefOid,
    };
    pr.reviews.push(review);
    for (const c of payload.comments ?? []) {
      const id = nextId(state);
      pr.reviewComments.push({
        id,
        threadId: `PRRT_${id}`,
        user: login,
        body: c.body ?? "",
        created_at: nowIso(),
        path: c.path,
        line: c.line ?? null,
      });
    }
    save(state);
    return emit(JSON.stringify({ id: review.id }));
  }
  if (segmentsEqual(segments, ["repos", "*", "*", "pulls", "*", "reviews"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    return emit(JSON.stringify(pr.reviews.map(asGhReview)));
  }
  if (method === "POST" && segmentsEqual(segments, ["repos", "*", "*", "pulls", "*", "comments", "*", "replies"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    const parent = pr.reviewComments.find((c) => c.id === Number(segments[6]));
    if (parent === undefined) fail(`no review comment ${segments[6]}`);
    const id = nextId(state);
    pr.reviewComments.push({
      id,
      user: login,
      body: fields.body ?? "",
      created_at: nowIso(),
      in_reply_to: parent.id,
      path: parent.path,
      line: parent.line ?? null,
    });
    save(state);
    return emit(JSON.stringify({ id }));
  }
  if (segmentsEqual(segments, ["repos", "*", "*", "pulls", "*", "comments"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    return emit(JSON.stringify(pr.reviewComments.map(asGhComment)));
  }
  if (method === "GET" && segmentsEqual(segments, ["repos", "*", "*", "pulls", "*"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    return emit(JSON.stringify({ body: pr.body }));
  }
  if (method === "PATCH" && segmentsEqual(segments, ["repos", "*", "*", "pulls", "*"])) {
    const pr = findPrOrDie(repoEntry(state, repo), Number(segments[4]));
    if (fields.body !== undefined) pr.body = fields.body;
    save(state);
    return emit(JSON.stringify({ body: pr.body }));
  }
  if (path === "graphql") return graphql(state, login, fields);
  fail(`api: unhandled ${method} ${rawPath}`);
}

/** The two GraphQL shapes the CLI verbs use: thread listing and resolution. */
function graphql(state, login, fields) {
  const query = fields.query ?? "";
  if (query.includes("resolveReviewThread")) {
    for (const entry of Object.values(state.repos)) {
      for (const pr of entry.prs) {
        const thread = pr.reviewComments.find(
          (c) => c.in_reply_to === undefined && threadIdOf(c) === fields.id,
        );
        if (thread !== undefined) {
          thread.resolved = true;
          save(state);
          return emit(JSON.stringify({ data: { resolveReviewThread: { thread: { isResolved: true } } } }));
        }
      }
    }
    fail(`graphql: no review thread ${fields.id}`);
  }
  if (query.includes("reviewThreads")) {
    const pr = findPrOrDie(repoEntry(state, `${fields.owner}/${fields.name}`), Number(fields.number));
    const nodes = pr.reviewComments
      .filter((c) => c.in_reply_to === undefined)
      .map((c) => ({
        id: threadIdOf(c),
        isResolved: c.resolved ?? false,
        path: c.path ?? null,
        line: c.line ?? null,
        comments: { nodes: [{ body: c.body }] },
      }));
    return emit(
      JSON.stringify({ data: { repository: { pullRequest: { reviewThreads: { nodes } } } } }),
    );
  }
  fail("graphql: unhandled query");
}

function threadIdOf(comment) {
  return comment.threadId ?? `PRRT_${comment.id}`;
}

function segmentsEqual(segments, pattern) {
  if (segments.length !== pattern.length) return false;
  return pattern.every((part, index) => part === "*" || part === segments[index]);
}

// The daemon's client validates raw gh API shapes: authors arrive as user objects.
function asGhComment(comment) {
  return { ...comment, user: { login: comment.user } };
}

function asGhReview(review) {
  return { ...review, user: { login: review.user } };
}

function issueList(state) {
  const requested = jsonFields(args);
  if (requested === null || requested.join(",") !== "number,title,url,assignees,labels") {
    fail("issue list: unexpected --json fields");
  }
  const issues = repoEntry(state, repoFlag(args)).issues
    .filter((issue) => issue.state === "open")
    .map((issue) => ({
      number: issue.number,
      title: issue.title,
      url: issue.url,
      assignees: issue.assignees.map((login) => ({ login })),
      labels: issue.labels.map((name) => ({ name })),
    }));
  return emit(JSON.stringify(issues));
}

function issueEdit(state) {
  const number = Number(args[2]);
  const issue = findIssue(repoEntry(state, repoFlag(args)), number);
  if (issue === null) fail(`no issue #${number}`);
  let changed = false;
  const add = flagValues(args, "--add-assignee");
  const remove = flagValues(args, "--remove-assignee");
  for (const login of add) {
    if (!issue.assignees.includes(login)) {
      issue.assignees.push(login);
      changed = true;
    }
  }
  for (const login of remove) {
    if (issue.assignees.includes(login)) {
      issue.assignees = issue.assignees.filter((existing) => existing !== login);
      changed = true;
    }
  }
  if (changed) save(state);
  return emit("");
}

function prList(state) {
  const requested = jsonFields(args);
  const known = ["number", "headRefName", "headRefOid", "mergeable", "reviewDecision", "statusCheckRollup", "url"];
  if (requested === null || !requested.every((field) => known.includes(field))) {
    fail("pr list: unexpected --json fields");
  }
  const repoName = repoFlag(args);
  const head = singleFlag(args, "--head");
  const stateArg = singleFlag(args, "--state") ?? "open";
  const prs = repoEntry(state, repoName).prs
    .filter((pr) => pr.state === stateArg)
    .filter((pr) => head === undefined || pr.headRefName === head)
    .map((pr) => ({
      number: pr.number,
      headRefName: pr.headRefName,
      headRefOid: pr.headRefOid,
      mergeable: pr.mergeable,
      reviewDecision: reviewDecisionOf(pr),
      statusCheckRollup: pr.checks,
      url: prUrl(repoName, pr.number),
    }))
    .map((full) => Object.fromEntries(requested.map((field) => [field, full[field]])));
  return emit(JSON.stringify(prs));
}

function prCreate(state) {
  const repoName = repoFlag(args);
  const entry = repoEntry(state, repoName);
  const head = singleFlag(args, "--head");
  if (head === undefined) fail("pr create: needs --head");
  const number = entry.prs.reduce((max, pr) => Math.max(max, pr.number), 0) + 1;
  entry.prs.push({
    number,
    headRefName: head,
    headRefOid: `sha-${number}`,
    mergeable: "MERGEABLE",
    checks: [],
    reviews: [],
    reviewComments: [],
    requestedReviewers: [],
    body: singleFlag(args, "--body") ?? "",
    title: singleFlag(args, "--title") ?? "",
    state: "open",
  });
  save(state);
  return emit(prUrl(repoName, number));
}

function prMerge(state) {
  const pr = findPrOrDie(repoEntry(state, repoFlag(args)), Number(args[2]));
  pr.state = "merged";
  closeReferencedIssues(repoEntry(state, repoFlag(args)), pr);
  save(state);
  return emit("");
}

function prEdit(state) {
  const pr = findPrOrDie(repoEntry(state, repoFlag(args)), Number(args[2]));
  for (const login of flagValues(args, "--add-reviewer")) {
    if (!pr.requestedReviewers.includes(login)) pr.requestedReviewers.push(login);
  }
  save(state);
  return emit("");
}

function prReview(state) {
  const pr = findPrOrDie(repoEntry(state, repoFlag(args)), Number(args[2]));
  const stateArg = args.includes("--approve")
    ? "APPROVED"
    : args.includes("--request-changes")
      ? "CHANGES_REQUESTED"
      : null;
  if (stateArg === null) fail("pr review: needs --approve or --request-changes");
  const bodyFlagIndex = args.indexOf("--body");
  pr.reviews.push({
    id: nextId(state),
    user: loginFor(state),
    state: stateArg,
    submitted_at: nowIso(),
    body: bodyFlagIndex === -1 ? null : (args[bodyFlagIndex + 1] ?? null),
    commit_id: pr.headRefOid,
  });
  save(state);
  return emit("");
}

function repoView(state) {
  const repo = repoFlag(args) ?? repoNames(state)[0];
  if (repo === undefined) fail("no repo in fake state");
  if (!canRead(state, loginFor(state), repo)) fail(`Must have read access to ${repo}`);
  return emit(`* ${repo}`);
}

function authStatus(state) {
  return emit(`github.com\n  ✓ Logged in to github.com account ${loginFor(state)}`);
}

// The device-code login the review-account onboarding drives: print the code
// and URL gh prints, and treat the login as completed immediately.
function authLogin(state) {
  process.stderr.write(`\n! First copy your one-time code: ${state.deviceCode ?? "PIDE-DEVC"}\n`);
  process.stderr.write("Open this URL to continue in your web browser: https://github.com/login/device\n");
  return emit("");
}

function authToken(state) {
  const entry = Object.entries(state.tokens).find(([, login]) => login !== state.primaryLogin);
  if (entry === undefined) fail("no review-account token in fake state");
  return emit(entry[0]);
}

function jsonFields(rest) {
  const index = rest.indexOf("--json");
  if (index === -1 || rest[index + 1] === undefined) return null;
  return rest[index + 1].split(",");
}

function singleFlag(rest, flag) {
  const values = flagValues(rest, flag);
  return values.length === 0 ? undefined : values[0];
}

function flagValues(rest, flag) {
  const values = [];
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === flag) values.push(rest[i + 1]);
  }
  return values;
}

function reviewDecisionOf(pr) {
  const latest = [...pr.reviews].sort((a, b) => a.id - b.id).at(-1);
  if (latest === undefined) return null;
  return latest.state === "APPROVED" || latest.state === "CHANGES_REQUESTED" ? latest.state : null;
}

function emit(text, trailingNewline = true) {
  process.stdout.write(trailingNewline ? `${text}\n` : text);
}

// Test-facing state mutations: `gh __op <operation> <json>`. Operations
// carry an explicit repo (payload.repo); it defaults to the first repo.
function targetRepo(state, payload) {
  const repo = payload.repo ?? repoNames(state)[0];
  if (repo === undefined) fail("no repo in fake state");
  return repoEntry(state, repo);
}

function applyChecks(pr, payload) {
  pr.checks =
    payload.status === "failed"
      ? payload.failingChecks.map((checkName) => ({
          name: checkName,
          status: "COMPLETED",
          conclusion: "FAILURE",
        }))
      : payload.status === "pending"
        ? [{ name: "ci", status: "IN_PROGRESS", state: "PENDING" }]
        : [{ name: "ci", status: "COMPLETED", conclusion: "SUCCESS" }];
}

function op(state) {
  const name = args[1];
  const payload = args[2] === undefined ? {} : JSON.parse(args[2]);
  if (name === "addRepo") {
    const newRepo = payload.repo;
    if (state.repos[newRepo] === undefined) {
      state.repos[newRepo] = { issues: [], comments: {}, prs: [], upstreamSha: payload.upstreamSha ?? null };
    }
    save(state);
    emit("");
    return;
  }
  const repoName = payload.repo ?? repoNames(state)[0];
  if (repoName === undefined) fail("no repo in fake state");
  const repo = repoEntry(state, repoName);
  switch (name) {
    case "openIssue":
      repo.issues.push({
        number: payload.number,
        title: payload.title,
        url: `https://github.com/${repoName}/issues/${payload.number}`,
        state: "open",
        assignees: payload.assignees ?? [],
        labels: [],
        blockedBy: payload.blockedBy ?? [],
      });
      break;
    case "setBlockedBy": {
      const issue = findIssue(repo, payload.issue);
      if (issue === null) fail(`no issue #${payload.issue}`);
      issue.blockedBy = payload.blockers;
      break;
    }
    case "openPr":
      repo.prs.push({
        number: payload.number,
        headRefName: `pideck/issue-${payload.issue}`,
        headRefOid: payload.headSha,
        mergeable: payload.mergeable ?? "MERGEABLE",
        checks: [],
        reviews: [],
        reviewComments: [],
        requestedReviewers: [],
        body: payload.body ?? `Closes #${payload.issue}`,
        state: "open",
      });
      break;
    case "setCI": {
      const pr = findPrOrDie(repo, payload.pr);
      applyChecks(pr, payload);
      break;
    }
    case "push": {
      const pr = findPrOrDie(repo, payload.pr);
      pr.headRefOid = payload.headSha;
      if (payload.ci !== undefined) {
        applyChecks(pr, payload.ci);
      }
      break;
    }
    case "addReview": {
      const pr = findPrOrDie(repo, payload.pr);
      const review = {
        id: nextId(state),
        user: payload.by,
        state: payload.reviewState,
        submitted_at: nowIso(),
        body: payload.body ?? null,
        commit_id: pr.headRefOid,
      };
      pr.reviews.push(review);
      emit(JSON.stringify({ id: review.id }), false);
      save(state);
      return;
    }
    case "assign": {
      const issue = findIssue(repo, payload.issue);
      if (issue === null) fail(`no issue #${payload.issue}`);
      if (!issue.assignees.includes(payload.login)) issue.assignees.push(payload.login);
      break;
    }
    case "merge": {
      const pr = findPrOrDie(repo, payload.pr);
      pr.state = "merged";
      closeReferencedIssues(repo, pr);
      break;
    }
    case "addComment": {
      const list = repo.comments[String(payload.number)] ?? [];
      const comment = {
        id: nextId(state),
        user: payload.author,
        body: payload.body,
        created_at: nowIso(),
      };
      list.push(comment);
      repo.comments[String(payload.number)] = list;
      emit(JSON.stringify({ id: comment.id }), false);
      save(state);
      return;
    }
    case "state":
      emit(JSON.stringify(state), false);
      return;
    case "repoState":
      emit(JSON.stringify(repo), false);
      return;
    default:
      fail(`unknown __op ${name}`);
  }
  save(state);
  emit("");
}

async function dispatch() {
  const state = load();
  if (args.includes("--input")) stdinData = await readStdin();
  if (args[0] === "__op") {
    op(state);
  } else if (args[0] === "auth" && args[1] === "status") {
    authStatus(state);
  } else if (args[0] === "auth" && args[1] === "login") {
    authLogin(state);
  } else if (args[0] === "auth" && args[1] === "token") {
    authToken(state);
  } else if (args[0] === "issue" && args[1] === "list") {
    issueList(state);
  } else if (args[0] === "issue" && args[1] === "edit") {
    issueEdit(state);
  } else if (args[0] === "pr" && args[1] === "list") {
    prList(state);
  } else if (args[0] === "pr" && args[1] === "create") {
    prCreate(state);
  } else if (args[0] === "pr" && args[1] === "merge") {
    prMerge(state);
  } else if (args[0] === "pr" && args[1] === "edit") {
    prEdit(state);
  } else if (args[0] === "pr" && args[1] === "review") {
    prReview(state);
  } else if (args[0] === "repo" && args[1] === "view") {
    repoView(state);
  } else if (args[0] === "api") {
    gh(state);
  } else {
    fail(`unhandled command: ${args.join(" ")}`);
  }
}

function readStdin() {
  return new Promise((resolve, reject) => {
    const chunks = [];
    process.stdin.on("data", (chunk) => chunks.push(chunk));
    process.stdin.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
    process.stdin.on("error", reject);
  });
}

