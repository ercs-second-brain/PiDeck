#!/bin/sh
# shellcheck shell=sh disable=SC1090,SC1091
#
# agentskiss CLI — installed to ~/.agentskiss/bin/agentskiss (symlinked into
# ~/.local/bin by the installer).
#
# One entry point, two surfaces (precedence — see install/README.md):
#
#   Service control, handled by this shim:
#     agentskiss service start|stop|restart|status
#     agentskiss start|stop|restart       bare shortcuts (no bare `status` —
#                                         that verb belongs to the daemon CLI)
#     agentskiss addr                     webapp URL for this machine
#     agentskiss onboard [flags]          (re-)run guided onboarding
#     agentskiss logs [-f]                daemon logs
#     agentskiss help
#
#   Everything else is forwarded verbatim (args intact, exit code propagated)
#   to the daemon CLI (apps/daemon/src/cli): status, project, kanban,
#   sessions, workers, pulls, diff, spawn, send, issue, ...

set -u

AK_HOME="${AGENTSKISS_HOME:-$HOME/.agentskiss}"
AK_ENV="$AK_HOME/env"

if [ -f "$AK_ENV" ]; then
  # set -a: export everything to the daemon CLI we exec below (it reads
  # AGENTSKISS_WEB_PORT & co. from its process environment).
  set -a
  . "$AK_ENV"
  set +a
else
  printf 'agentskiss: %s not found — run the agentskiss installer first\n' "$AK_ENV" >&2
  exit 1
fi

AK_LIB="$AK_HOME/lib"
[ -f "$AK_LIB/common.sh" ] || { printf 'agentskiss: install broken, %s missing\n' "$AK_LIB" >&2; exit 1; }
. "$AK_LIB/common.sh"
. "$AK_LIB/service.sh"

detect_os

daemon_cli_bin() {
  printf '%s/apps/daemon/dist/cli/main.js' "${AGENTSKISS_SRC:-$AK_HOME/src}"
}

forward_to_daemon_cli() {
  _cli_bin=$(daemon_cli_bin)
  if [ ! -f "$_cli_bin" ]; then
    printf 'agentskiss: daemon CLI missing (%s) — re-run the installer or build apps/daemon\n' "$_cli_bin" >&2
    exit 1
  fi
  # Loopback URL for the daemon API unless the caller picked one; keeps the
  # forwarded CLI independent of AGENTSKISS_WEB_HOST (0.0.0.0 under WSL).
  AGENTSKISS_DAEMON_URL="${AGENTSKISS_DAEMON_URL:-http://127.0.0.1:${AGENTSKISS_WEB_PORT:-8321}}"
  export AGENTSKISS_DAEMON_URL
  exec "${AGENTSKISS_NODE:-node}" "$_cli_bin" "$@"
}

print_help() {
  cat <<'EOF'
agentskiss — control the agentsKISS daemon/webapp and talk to it

Service control (this shim):
  service start|stop|restart|status   manage the persistent service
  start|stop|restart                  shortcuts for the same (no bare `status`)
  addr                                print the webapp URL for this machine
  onboard [flags]                     (re-)run guided onboarding (--dry-run, --skip-pi, --skip-gh)
  logs [-f]                           tail daemon logs

Agent CLI (forwarded to the daemon):
  status [--json]
  project get <id> | ls [--json]
  kanban|sessions|workers|pulls --project <id> [--json]
  diff --project <id> <pr-number>
  spawn --project <id> [--issue <n>] --name <label> [--prompt <task>]
  send --session <id> --message <text>

Any other subcommand is forwarded to the daemon CLI untouched.
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  service)
    svc_cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case "$svc_cmd" in
      start) svc_start ;;
      stop) svc_stop ;;
      restart) svc_restart ;;
      status)
        svc_status
        printf '\nwebapp: %s\n' "$(webapp_url)"
        if _win_url=$(windows_host_url 2>/dev/null); then
          printf 'from Windows (host browser): %s\n' "$_win_url"
        fi
        ;;
      help | -h | --help) print_help ;;
      *)
        printf 'agentskiss: unknown service command: %s\n' "$svc_cmd" >&2
        printf 'usage: agentskiss service start|stop|restart|status\n' >&2
        exit 1
        ;;
    esac
    ;;
  start) svc_start ;;
  stop) svc_stop ;;
  restart) svc_restart ;;
  addr)
    webapp_url
    printf '\n'
    if _win_url=$(windows_host_url 2>/dev/null); then
      printf 'from Windows (host browser): %s\n' "$_win_url"
    fi
    ;;
  onboard)
    # shellcheck disable=SC2086
    sh "$AK_LIB/onboard.sh" "$@"
    ;;
  logs)
    tail -n 100 "$@" "$AK_HOME/log/daemon.out.log" "$AK_HOME/log/daemon.err.log" 2>/dev/null
    ;;
  help | -h | --help)
    print_help
    ;;
  *)
    # Not a shim verb — hand it to the daemon CLI verbatim. Bare `status`
    # resolves here on purpose (daemon health for the pi skills); service
    # status is `agentskiss service status`. See install/README.md.
    forward_to_daemon_cli "$cmd" "$@"
    ;;
esac
