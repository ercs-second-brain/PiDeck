#!/bin/sh
# shellcheck shell=sh disable=SC1090,SC1091
#
# pideck CLI — installed to ~/.pideck/bin/pideck (symlinked into
# ~/.local/bin by the installer).
#
# One entry point, two surfaces (precedence — see install/README.md):
#
#   Service control, handled by this shim:
#     pideck service start|stop|restart|status
#     pideck start|stop|restart       bare shortcuts (no bare `status` —
#                                         that verb belongs to the daemon CLI)
#     pideck addr                     webapp URL for this machine
#     pideck onboard [flags]          (re-)run guided onboarding
#     pideck update [--check]         fetch/rebuild/restart when the
#                                         upstream ref advanced (--check:
#                                         report only)
#     pideck logs [-f]                daemon logs
#     pideck help
#
#   Everything else is forwarded verbatim (args intact, exit code propagated)
#   to the daemon CLI (apps/daemon/src/cli): status, project, kanban,
#   sessions, workers, pulls, diff, spawn, send, issue, ...

set -u

PD_HOME="${PD_HOME:-$HOME/.pideck}"

PD_ENV="$PD_HOME/env"

if [ -f "$PD_ENV" ]; then
  # set -a: export everything to the daemon CLI we exec below (it reads
  # PD_WEB_PORT & co. from its process environment).
  set -a
  . "$PD_ENV"
  set +a
else
  printf 'pideck: %s not found — run the pideck installer\n' "$PD_ENV" >&2
  exit 1
fi

PD_LIB="$PD_HOME/lib"
[ -f "$PD_LIB/common.sh" ] || { printf 'pideck: install broken, %s missing\n' "$PD_LIB" >&2; exit 1; }
. "$PD_LIB/common.sh"
. "$PD_LIB/service.sh"

# Issues #208/#213: PD_NODE (env file), PD_NODE_BIN and PD_NODE_BIN_DIR
# (service env) are three generations of the same variable, and a
# fe43fa0-era install can present ANY subset — stale or partial (observed
# live: PD_NODE + PD_NODE_BIN exported, PD_NODE_BIN_DIR missing →
# `PD_NODE_BIN_DIR: parameter not set` killed `pideck update` mid-suite).
# Gating the derivation on the legacy vars therefore still trusts stale
# values, so derive the ONE canonical set on EVERY run, in priority order:
#   1. PD_NODE from the env file (canonical: refresh_node_runtime keeps it
#      on the pinned private runtime),
#   2. legacy PD_NODE_BIN (older service-env generation),
#   3. the newest node-v* dir under $PD_HOME/opt (survives node renames),
#   4. whatever node is on PATH,
# then normalize all three to that runtime — every later read (service
# unit rendering, daemon CLI exec) sees a consistent, executable node.
_pd_node=${PD_NODE:-}
[ -x "$_pd_node" ] || _pd_node=${PD_NODE_BIN:-}
if [ ! -x "$_pd_node" ]; then
  _pd_newest=
  _pd_newest_ver=
  for _pd_cand in "$PD_HOME"/opt/node-v*/bin/node; do
    [ -x "$_pd_cand" ] || continue
    _pd_ver=${_pd_cand#*node-v}
    _pd_ver=${_pd_ver%%/*}
    if [ -z "$_pd_newest" ] || ! _node_version_ge "$_pd_newest_ver" "$_pd_ver"; then
      _pd_newest=$_pd_cand
      _pd_newest_ver=$_pd_ver
    fi
  done
  _pd_node=$_pd_newest
fi
[ -x "$_pd_node" ] || _pd_node=$(command -v node 2>/dev/null) || :
if [ -n "$_pd_node" ] && [ -x "$_pd_node" ]; then
  PD_NODE=$_pd_node
  PD_NODE_BIN=$_pd_node
  PD_NODE_BIN_DIR=$(dirname "$_pd_node")
  export PD_NODE PD_NODE_BIN PD_NODE_BIN_DIR
else
  printf 'pideck: no node runtime found (PD_NODE unset, no %s/opt/node-v*, no node on PATH) — run the pideck installer\n' "$PD_HOME" >&2
  exit 1
fi

detect_os

daemon_cli_bin() {
  printf '%s/apps/daemon/dist/cli/main.js' "${PD_SRC:-$PD_HOME/src}"
}

forward_to_daemon_cli() {
  _cli_bin=$(daemon_cli_bin)
  if [ ! -f "$_cli_bin" ]; then
    printf 'pideck: daemon CLI missing (%s) — re-run the installer or build apps/daemon\n' "$_cli_bin" >&2
    exit 1
  fi
  # Loopback URL for the daemon API unless the caller picked one; keeps the
  # forwarded CLI independent of PD_WEB_HOST (0.0.0.0 under WSL).
  PD_DAEMON_URL="${PD_DAEMON_URL:-http://127.0.0.1:${PD_WEB_PORT:-8321}}"
  export PD_DAEMON_URL
  exec "${PD_NODE:-node}" "$_cli_bin" "$@"
}

print_help() {
  cat <<'EOF'
pideck — control the PiDeck daemon/webapp and talk to it

Service control (this shim):
  service start|stop|restart|status   manage the persistent service
  start|stop|restart                  shortcuts for the same (no bare `status`)
  addr                                print the webapp URL for this machine
  onboard [flags]                     (re-)run guided onboarding (--dry-run, --skip-pi, --skip-gh)
  update [--check]                    apply upstream updates (fetch via gh-authed
                                      git, rebuild, restart; --check reports only)
  logs [-f]                           tail daemon logs

Agent CLI (forwarded to the daemon):
  status [--json]
  project get <id> | ls [--json]
  kanban|sessions|workers|pulls --project <id> [--json]
  diff --project <id> <pr-number>
  spawn --project <id> [--issue <n>] --name <label> [--prompt <task>]
  send --session <id> --message <text>

Any other subcommand is forwarded to the daemon CLI untouched.
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  service)
    svc_cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case "$svc_cmd" in
      start) svc_start ;;
      stop) svc_stop ;;
      restart) svc_restart ;;
      status)
        svc_status
        printf '\nwebapp: %s\n' "$(webapp_url)"
        if _win_url=$(windows_host_url 2>/dev/null); then
          printf 'from Windows (host browser): %s\n' "$_win_url"
        fi
        ;;
      help | -h | --help) print_help ;;
      *)
        printf 'pideck: unknown service command: %s\n' "$svc_cmd" >&2
        printf 'usage: pideck service start|stop|restart|status\n' >&2
        exit 1
        ;;
    esac
    ;;
  start) svc_start ;;
  stop) svc_stop ;;
  restart) svc_restart ;;
  addr)
    webapp_url
    printf '\n'
    if _win_url=$(windows_host_url 2>/dev/null); then
      printf 'from Windows (host browser): %s\n' "$_win_url"
    fi
    ;;
  onboard)
    # shellcheck disable=SC2086
    sh "$PD_LIB/onboard.sh" "$@"
    ;;
  update)
    upd_cmd=${1:-apply}
    [ $# -gt 0 ] && shift
    [ -f "$PD_LIB/update.sh" ] || { printf 'pideck: install broken, %s missing\n' "$PD_LIB/update.sh" >&2; exit 1; }
    # shellcheck disable=SC1090 # installed lib dir, sourced on purpose
    . "$PD_LIB/update.sh"
    case "$upd_cmd" in
      --check | -c) update_check; update_report ;;
      apply | '') update_apply ;;
      *)
        printf 'pideck: unknown update command: %s\n' "$upd_cmd" >&2
        printf 'usage: pideck update [--check]\n' >&2
        exit 1
        ;;
    esac
    ;;
  logs)
    tail -n 100 "$@" "$PD_HOME/log/daemon.out.log" "$PD_HOME/log/daemon.err.log" 2>/dev/null
    ;;
  help | -h | --help)
    print_help
    ;;
  *)
    # Not a shim verb — hand it to the daemon CLI verbatim. Bare `status`
    # resolves here on purpose (daemon health for the pi skills); service
    # status is `pideck service status`. See install/README.md.
    forward_to_daemon_cli "$cmd" "$@"
    ;;
esac
