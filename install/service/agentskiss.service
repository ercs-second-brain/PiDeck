# agentsKISS daemon — systemd user unit template.
# Placeholders (@AK_…@) are substituted by install/lib/service.sh at install
# time. Installed to ~/.config/systemd/user/agentskiss.service.
#
# WSL: this is the WSL service path too — the Windows bootstrap
# (windows/agentskiss-setup.ps1) enables systemd in the distro and runs the
# Linux installer inside it.

[Unit]
Description=agentsKISS daemon + webapp
Documentation=https://github.com/ercs-second-brain/agentsKISS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@AK_SRC@
ExecStart=@AK_HOME@/bin/agentskiss-daemon
Environment=PATH=@AK_SERVE_PATH@
Environment=AGENTSKISS_HOME=@AK_HOME@
Environment=AGENTSKISS_WEB_PORT=@AK_PORT@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
