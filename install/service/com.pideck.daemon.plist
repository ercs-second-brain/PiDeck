<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PiDeck daemon — macOS launchd agent template.
  Placeholders (@PD_…@) are substituted by install/lib/service.sh at install
  time. Runs $HOME-based paths only, no root required. RunAtLoad starts the
  daemon at login; KeepAlive (SuccessfulExit=false) restarts it on crash.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pideck.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>@PD_HOME@/bin/pideck-daemon</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PD_SERVE_PATH@</string>
        <key>PD_HOME</key>
        <string>@PD_HOME@</string>
        <key>PD_WEB_PORT</key>
        <string>@PD_PORT@</string>
        <key>PD_SRC</key>
        <string>@PD_SRC@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@PD_HOME@/log/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>@PD_HOME@/log/daemon.err.log</string>
</dict>
</plist>
