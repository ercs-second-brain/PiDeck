{
  "name": "agentskiss",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, single-command AI coding agent orchestration platform",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "kiss:knip": "node scripts/kiss-knip.mjs",
    "kiss:complexity": "node scripts/kiss-complexity.mjs",
    "kiss:dup": "jscpd --baseline kiss-baseline/jscpd.json --fail-on-new-clones 0 apps packages install",
    "kiss:dup:trim": "node scripts/kiss-dup-trim.mjs",
    "kiss": "pnpm run kiss:knip && pnpm run kiss:complexity && pnpm run kiss:dup && pnpm run kiss:dup:trim",
    "kiss:baseline": "node scripts/kiss-baseline.mjs",
    "prepare": "husky",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm kiss"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "jscpd": "^5.1.2",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
  }
}
